[Unit]
Description=AuxLink: temporary preheat / USB-C overnight debug log (SD card)
After=auxlink-usb-gadget.service auxlink-media.service
ConditionPathExists=/etc/auxlink.conf

[Service]
Type=simple
ExecStart=/usr/local/bin/auxlink-preheat-debug.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
