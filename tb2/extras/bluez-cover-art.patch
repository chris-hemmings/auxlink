diff --git a/profiles/audio/avrcp.c b/profiles/audio/avrcp.c
index 8d1e03b..e98bc75 100644
--- a/profiles/audio/avrcp.c
+++ b/profiles/audio/avrcp.c
@@ -484,8 +484,76 @@ static sdp_record_t *avrcp_ct_record(bool browsing)
 	return record;
 }
 
+/*
+ * teslabridge: the PSM of the cover-art (BIP) server, from the environment
+ * (TB_COVER_ART_PSM=0x1025). Unset or 0 = no cover art, as stock BlueZ.
+ */
+static uint16_t tb_cover_art_psm(void)
+{
+	const char *v = getenv("TB_COVER_ART_PSM");
+	unsigned long psm;
+
+	if (!v || !*v)
+		return 0;
+	psm = strtoul(v, NULL, 0);
+	/* Dynamic PSMs are odd with an even upper byte, 0x1001..0xffff */
+	if (psm < 0x1001 || psm > 0xffff || !(psm & 1) || (psm & 0x100))
+		return 0;
+	return psm;
+}
+
+/*
+ * teslabridge: Additional Protocol Descriptor List with browsing (optional)
+ * and cover art: ((L2CAP, browsing PSM), (AVCTP, ver)), ((L2CAP, psm), (OBEX)).
+ */
+static void tb_add_protos_record(sdp_record_t *record, sdp_data_t *version,
+					bool browsing, uint16_t cover_psm)
+{
+	sdp_list_t *aproto = NULL, *bseq = NULL, *cseq = NULL;
+	sdp_list_t *bproto[2] = { NULL, NULL }, *cproto[2] = { NULL, NULL };
+	uuid_t l2cap, avctp, obex;
+	sdp_data_t *bpsm = NULL, *cpsm;
+	uint16_t ap = AVCTP_BROWSING_PSM;
+
+	sdp_uuid16_create(&l2cap, L2CAP_UUID);
+
+	if (browsing) {
+		bproto[0] = sdp_list_append(NULL, &l2cap);
+		bpsm = sdp_data_alloc(SDP_UINT16, &ap);
+		bproto[0] = sdp_list_append(bproto[0], bpsm);
+		bseq = sdp_list_append(NULL, bproto[0]);
+		sdp_uuid16_create(&avctp, AVCTP_UUID);
+		bproto[1] = sdp_list_append(NULL, &avctp);
+		bproto[1] = sdp_list_append(bproto[1], version);
+		bseq = sdp_list_append(bseq, bproto[1]);
+		aproto = sdp_list_append(aproto, bseq);
+	}
+
+	cproto[0] = sdp_list_append(NULL, &l2cap);
+	cpsm = sdp_data_alloc(SDP_UINT16, &cover_psm);
+	cproto[0] = sdp_list_append(cproto[0], cpsm);
+	cseq = sdp_list_append(NULL, cproto[0]);
+	sdp_uuid16_create(&obex, OBEX_UUID);
+	cproto[1] = sdp_list_append(NULL, &obex);
+	cseq = sdp_list_append(cseq, cproto[1]);
+	aproto = sdp_list_append(aproto, cseq);
+
+	sdp_set_add_access_protos(record, aproto);
+
+	free(bpsm);
+	free(cpsm);
+	sdp_list_free(bproto[0], NULL);
+	sdp_list_free(bproto[1], NULL);
+	sdp_list_free(bseq, NULL);
+	sdp_list_free(cproto[0], NULL);
+	sdp_list_free(cproto[1], NULL);
+	sdp_list_free(cseq, NULL);
+	sdp_list_free(aproto, NULL);
+}
+
 static sdp_record_t *avrcp_tg_record(bool browsing)
 {
+	uint16_t cover_psm;
 	sdp_list_t *svclass_id, *pfseq, *apseq, *root;
 	uuid_t root_uuid, l2cap, avctp, avrtg;
 	sdp_profile_desc_t profile[1];
@@ -530,7 +598,15 @@ static sdp_record_t *avrcp_tg_record(bool browsing)
 	sdp_set_access_protos(record, aproto_control);
 
 	/* Additional Protocol Descriptor List */
-	if (browsing) {
+	cover_psm = tb_cover_art_psm();
+	if (cover_psm) {
+		/* teslabridge: advertise AVRCP 1.6 cover art, served over OBEX
+		 * (BIP) on cover_psm by an external server. */
+		feat |= AVRCP_FEATURE_TG_COVERT_ART;
+		if (browsing)
+			feat |= AVRCP_FEATURE_BROWSING;
+		tb_add_protos_record(record, version, browsing, cover_psm);
+	} else if (browsing) {
 		feat |= AVRCP_FEATURE_BROWSING;
 		avrcp_browsing_record(record, version);
 	}
