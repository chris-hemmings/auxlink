[Unit]
Description=teslabridge: cut USB power at shutdown (RTL8761BU warm-reboot hang)
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bt-usb-cycle.sh off
TimeoutStartSec=15

[Install]
WantedBy=shutdown.target reboot.target halt.target
