[Unit]
Description=teslabridge: album art for the car (AVRCP cover art server)
After=bluetooth.service
Requires=bluetooth.service
# The listening socket belongs to the adapter: restart with bluetoothd.
PartOf=bluetooth.service

[Service]
ExecStart=/usr/local/bin/tb-cover.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target bluetooth.service
