[Unit]
Description=teslabridge: HFP call relay between the car and the phone
After=bluetooth.service
Requires=bluetooth.service
# Restart together with bluetoothd: everything registered with it is lost
# when it restarts (profiles, media player, agent).
PartOf=bluetooth.service

[Service]
ExecStart=/usr/local/bin/hfp-relay.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target bluetooth.service
