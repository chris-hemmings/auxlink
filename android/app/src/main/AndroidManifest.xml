<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Bluetooth music source: the app talks to the Pi over Bluetooth. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Finding the Pi's setup page (Open setup page) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Never used to record. The XIAO is also a USB sound card (the car's
         mic for the SMO), and without this Android's plug-in prompt warns
         about audio capture and drops its "Always" tick box - so it asked
         at every plug-in. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Staying alive: a permanent "Phone Link connected" notification (a
         foreground service of the connected-device kind; CHANGE_NETWORK_STATE
         is its required companion permission, granted automatically), and
         the prompt that turns battery optimisation off for the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- The vehicle's location (the SMO publishes the car's GPS as the system
         mock location). Used only to tell the Pi "moving / stationary", so it
         won't drop the phone while the car is still moving. Optional: without
         it the Pi falls back to the car-Bluetooth-only check. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional, granted once from a computer (adb shell pm grant ...): lets
         the app keep Android's high-volume warning off (audio_safe_volume_state). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="Phone Link"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Plugging in the XIAO starts this invisible activity: tick "always"
             once and Android remembers the USB permission, without the app
             window popping up on every plug-in. -->
        <activity
            android:name=".UsbAttachActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="Phone Link (USB)">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <service
            android:name=".NowPlayingService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice|location"
            android:label="Phone Link"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
