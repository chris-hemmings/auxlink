<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Bluetooth music source: the app talks to the Pi over Bluetooth. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Finding the Pi's setup page (Open setup page) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Never used to record. The XIAO is also a USB sound card (the car's
         mic for the SMO), and without this Android's plug-in prompt warns
         about audio capture and drops its "Always" tick box - so it asked
         at every plug-in. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="AuxLink"
        android:icon="@android:drawable/ic_media_play"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Plugging in the XIAO starts this invisible activity: tick "always"
             once and Android remembers the USB permission, without the app
             window popping up on every plug-in. -->
        <activity
            android:name=".UsbAttachActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="AuxLink (USB)">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <service
            android:name=".NowPlayingService"
            android:exported="true"
            android:label="AuxLink"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
